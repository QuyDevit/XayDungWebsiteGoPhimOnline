
@{
    ViewBag.Title = "Văn bản trò chơi 1";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

@model ICollection<BestTyping.Models.DTO.EXERCISETEXTSYSTEM>
<div class="container">
    <div class="page-inner">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between">
                        <h4 class="card-title">Tất cả văn bản</h4>
                        <a href="@Url.Action("AddText","ExerciseTextSystem")" class="btn btn-primary btn-round">Thêm văn bản</a>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <div id="basic-datatables_wrapper" class="dataTables_wrapper container-fluid dt-bootstrap4">
                                <div class="col-sm-12">
                                    <table id="basic-datatables" class="display table table-striped table-hover" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>STT</th>
                                                <th>Loại văn bản</th>
                                                <th>Nội dung</th>
                                                <th>Ngôn ngữ</th>
                                                <th>Trạng thái</th>
                                                <th>Hành động</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int count = 1;
                                            }
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@count</td>
                                                    <td>@item.ExerciseName</td>
                                                    <td>@item.ExerciseText</td>
                                                    <td>@item.Language</td>
                                                    <td>
                                                        <div class="switch-content">
                                                            <input type="checkbox" id="checkbox-@item.Id" @(item.Status == true ? "checked" : "" ) onchange="lockText(@item.Id)">
                                                            <label class="switch" for="checkbox-@item.Id">
                                                                <span class="slider"></span>
                                                            </label>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="form-button-action">
                                                            <a href="@Url.Action("EditText", "ExerciseTextSystem", new {id=item.Id})" data-bs-toggle="tooltip" title="" class="btn btn-link btn-primary btn-lg" data-original-title="Edit Task">
                                                                <i class="fa fa-edit"></i>
                                                            </a>
                                                        </div>
                                                    </td>

                                                </tr>
                                                count++;
                                            }

                                        </tbody>
                                    </table>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $("#basic-datatables").DataTable();
    });
    function lockText(value) {
        $.ajax({
            type: 'post',
            url: '@Url.Action("LockText", "ExerciseTextSystem")',
            data: {
                id: value
            },
            success: function (response) {
                if (response.code == 200) {

                } else {

                    console.log(response.msg);
                }
            },
            error: function (err) {
                // Xử lý lỗi nếu có
                console.log(err);
            }
        });
    }
</script>


