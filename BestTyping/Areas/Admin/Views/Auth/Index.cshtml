
@{
    Layout = null;
}


<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="~/Theme/images/icon_main2.png" type="image/png">
    <title>Đăng nhập - Admin</title>
    <link href="~/Theme/css/styles.min.css" rel="stylesheet" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
    <!--  Body Wrapper -->
    <div class="page-wrapper" id="main-wrapper" data-layout="vertical" data-navbarbg="skin6" data-sidebartype="full"
         data-sidebar-position="fixed" data-header-position="fixed" style="background-image: url('/Theme/images/login-3.png');background-size:cover">
        <div class="position-relative overflow-hidden radial-gradient min-vh-100 d-flex align-items-center justify-content-center">
            <div class="d-flex align-items-center justify-content-center w-100">
                <div class="row justify-content-center w-100">
                    <div class="col-md-8 col-lg-6 col-xxl-3">
                        <div class="card mb-0">
                            <div class="card-body">
                                <a href="javascript:void(0)" class="text-nowrap logo-img text-center d-block py-3 w-100 d-flex align-items-center justify-content-center">
                                    <img src="~/Theme/images/icon_main2.png" style="width:40px;margin-right:10px" alt="">
                                    <span style="font-size:28px;font-weight:bold">FastTyping</span>
                                </a>
                                <form>
                                    <div class="mb-3">
                                        <label for="exampleInputEmail1" class="form-label">Tài khoản</label>
                                        <input placeholder="Tài khoản" type="email" class="form-control" id="username">
                                    </div>
                                    <div class="mb-4">
                                        <label for="exampleInputPassword1" class="form-label">Mật khẩu</label>
                                        <input placeholder="Mật khẩu" type="password" class="form-control" id="password">
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between mb-4">
                                        <div class="form-check">
                                            <input class="form-check-input primary" type="checkbox" value="" id="flexCheckChecked" checked>
                                            <label class="form-check-label text-dark" for="flexCheckChecked">
                                                Ghi nhớ
                                            </label>
                                        </div>
                                        <a class="text-primary fw-bold" href="javascript:void(0)">Quên mật khẩu ?</a>
                                    </div>
                                    <a href="javascript:void(0)" onclick="loginAdmin()" class="btn btn-primary w-100 py-8 fs-4 mb-4 rounded-2">Đăng nhập</a>
                                    <div class="d-flex align-items-center justify-content-center">
                                        <a class="text-primary fw-bold ms-2" href="javascript:void(0)">Chưa có tài khoản?</a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/Theme/js/jquery.min.js"></script>
    <script src="~/Theme/js/bootstrap.bundle.min.js"></script>


    <script>
        function ToastError(content) {
            // Error Toast
            Swal.fire({
                icon: 'error',
                title: "Thông báo",
                html: `<strong>${content}</strong>`,
                showCloseButton: true,
                showConfirmButton: true,
                confirmButtonText: 'OK',
            });
        }
        $("#username, #password").keypress(function (e) {
            if (e.which === 13) {
                loginAdmin();
            }
        });
        function loginAdmin() {
            const username = $("#username").val();
            const pass = $("#password").val();
            if (username == "" || pass == "") {
                ToastError("Vui lòng nhập đầy đủ thông tin!")
                return;
            }
            $.ajax({
                type: "POST",
                url: "@Url.Action("Login","Auth",new {area = "Admin"})",
                data: {
                    username: username,
                    pass: pass
                },
                success: function (reponse) {
                    if (reponse.code == 200) {
                        window.location.href = "/Admin/Home";
                    }
                    else {
                        ToastError(reponse.msg);
                    }
                },
                error: function (err) {

                }
            })      
        }
    </script>
</body>

</html>