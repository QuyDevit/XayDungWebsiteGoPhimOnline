@model IEnumerable<BestTyping.Models.EXERCISELANGUAGE>

@{
    ViewBag.Title = "TextTestEdu";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<link href="~/Theme/css/dashboardedu.css" rel="stylesheet" />
<link href="~/Theme/css/textpractice.css" rel="stylesheet" />
<style>
    .wapper-content{
        position:relative;
    }
    .loading-spinner {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }
    .btn-default:disabled {
        background-color: #ccc;
    }
</style>
<header class="site-header-two">
    @Html.Partial("_PartialNavTop")
</header>

<div class="wrapper">
    @Html.Action("_PartialSideBarEdu", "Home")
    <!-- Main Component -->
    <div class="main">
        <main class="content col-md-11 px-3 py-2">
            <div class="dashboard_wrapper">
                <div class="dashboard_wrapper-nav">
                    <h3>Quản lý văn bản</h3>
                    <ul class="list-group flex-row nav__tab">
                        <li class="nav-item">
                            <a href="@Url.Action("TextTestEdu","DashBoardEdu")" id="top-ranking-tab" class="button__tab-background show" data-tab="list-member">
                                <i class="fa fa-plus nav__tab-icon" aria-hidden="true"></i>
                                <span>Tạo văn bản</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("MyTextTestEdu","DashBoardEdu")" id="tests-taken-tab" class="button__tab-background" data-tab="browse-members">
                                <i class="fa fa-file-text-o nav__tab-icon" aria-hidden="true"></i>
                                <span>Văn bản của tôi</span>
                            </a>
                        </li>                     
                    </ul>
                    <div class="tab__wrapper">
                        <div class="tab__wrapper-content">
                            <div class="container">
                                <div class="title-textpractice">
                                    <p>Tạo văn bản</p>
                                </div>
                                <div class="textpractice_form">
                                    <div class="textpractice_form-item">
                                        <label for="languageSelect">Ngôn ngữ</label>

                                        <select class="form-select select-custom dropdown" id="languageSelect">

                                            @foreach (var item in Model)
                                            {
                                                <option value="@item.LanguageName">@item.LanguageName</option>
                                            }
                                        </select>


                                    </div>
                                    <div class="textpractice_form-item">
                                        <label for="titletext">Tiêu đề</label>
                                        <input id="titletext" class="form-control input-title" placeholder="Nhập tiêu đề văn bản" type="text" />
                                    </div>
                                    <div class="textpractice_form-item">
                                        <div class="d-flex justify-content-between mb-2">
                                            <div class="col-lg-6">
                                                <label for="contenttext">Nội dung</label>
                                            </div>
                                            <div class="col-lg-6 d-flex flex-column justify-content-end">
                                                <button type="button" class="btn-default" onclick="toggleFormAsk()">Ai Đề xuất văn bản</button>
                                                <div id="form-ask" class="d-flex flex-column justify-content-end d-none">
                                                    <p style="font-size:16px;color:#000;margin:12px 0;padding:0">Ghi chú: Nhớ chọn đúng ngôn ngữ và nhập chủ đề trước khi gửi: </p>
                                                    <strong style="margin-bottom:4px;">Ví dụ: du lịch</strong>
                                                    <div class="d-flex">
                                                        <input class="form-control" placeholder="Nhập chủ đề" id="content-ask" />
                                                        <button class="btn-default" onclick="submitAsk(this)" style="margin-left:8px;">Tạo</button>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                        <div class="wapper-content">
                                            <div class="loading-spinner d-none">
                                                <div class="spinner-border" style="color: #3fbbc0;width:3rem;height:3rem" role="status">
                                                    <span class="sr-only">Loading...</span>
                                                </div>
                                            </div>
                                            <textarea class="form-control textarea-custom" placeholder="Nhập nội dung văn bản" id="contenttext"></textarea>
                                        </div>
                                       
                                    </div>
                                        <div class="check-private">
                                            <input id="checkprivate" type="checkbox" />
                                            <label for="checkprivate" style="color:black">Không hiển thị</label>
                                        </div>
                                        <div class="textpractice_form-item">
                                            <button id="btn-createtext" type="button">Lưu văn bản</button>
                                        </div>
                                    </div>
                            </div>
                        </div>
                           
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
<script>
    function toggleFormAsk() {
        $("#form-ask").toggleClass("d-none");
    }
    function submitAsk(button) {
        const contentask = $("#content-ask").val();
        const language = $("#languageSelect").val();
        if (contentask == "") {
            Swal.fire({
                icon: 'error',
                title: "Thông báo",
                html: `<strong>Vui lòng nhập chủ đề</strong>`,
                showCloseButton: true,
                showConfirmButton: true,
                confirmButtonText: 'OK',
            });
            return;
        }
        $(".loading-spinner").removeClass("d-none");
        $(button).attr("disabled", true);
        $.ajax({
            url: '@Url.Action("ProposeText", "DashBoardEdu")',
            type: 'POST',
            data: {
                content: contentask,
                language: language
            },
            success: function (response) {
                try {
                    const jsonResponse = JSON.parse(response);

                    // Lấy phần "text" từ phản hồi
                    const assistantResponse = jsonResponse.candidates[0].content.parts[0].text;
                    console.log(assistantResponse);
                    $(".loading-spinner").addClass("d-none");
                    $(button).attr("disabled", false);
                    $("#contenttext").val(assistantResponse);
                } catch (ex) {
                    $(button).attr("disabled", false);
                    $(".loading-spinner").addClass("d-none");
                    Swal.fire({
                        icon: 'error',
                        title: "Thông báo",
                        html: `<strong>Vui lòng nhập chủ đề khác rõ hơn</strong>`,
                        showCloseButton: true,
                        showConfirmButton: true,
                        confirmButtonText: 'OK',
                    });
                }

            },
            error: function (err) {
                $(button).attr("disabled", false);
                $(".loading-spinner").addClass("d-none");
                Swal.fire({
                    icon: 'error',
                    title: "Thông báo",
                    html: `<strong>Vui lòng nhập chủ đề khác rõ hơn</strong>`,
                    showCloseButton: true,
                    showConfirmButton: true,
                    confirmButtonText: 'OK',
                });
            }
        });
    }
</script>
<script src="~/Theme/js/addtextedu.js"></script>