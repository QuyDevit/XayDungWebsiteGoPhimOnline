<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <meta name="description" content="">
    <meta name="author" content="">

    <title>BestTyping</title>

    <!-- CSS FILES -->
    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Open+Sans&display=swap" rel="stylesheet">
    <script src='https://www.google.com/recaptcha/api.js'></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link href="~/Theme/css/bootstrap.min.css" rel="stylesheet">

    <link href="~/Theme/css/bootstrap-icons.css" rel="stylesheet">
    <link rel="icon" href="~/Theme/images/icon_logo.png" type="image/png">
    <link href="~/Theme/css/style.css" rel="stylesheet" />
    <script src="~/Theme/js/jquery.min.js"></script>
    <script src="~/Theme/js/bootstrap.bundle.min.js"></script>
    <style>
        .content_number {
            flex-wrap: wrap;
            display: flex;
            background-color: #5ac5c9;
            color: #fff;
        }

        .menu_number_item_img {
            margin-right: 12px;
        }

        .menu_number_item {
            position: relative;
            justify-content: center;
            align-items: center;
            display: flex;
            width: 50%;
            padding: 27px 12px;
        }

        .item_title_number {
            font-size: 24px;
            color: #fff;
            margin: 0;
        }

        .item_content_number {
            font-size: 16px;
            color: #fff;
            margin: 0;
        }

        .content-why {
            margin: 72px 0 10px 0;
        }

        .content-why__title, .content-question__title {
            font-size: 36px;
            margin-bottom: 54px;
            padding-bottom: 20px;
            text-align: center;
            font-weight: 500;
            position: relative;
        }

            .content-why__title::after, .content-question__title::after {
                content: "";
                position: absolute;
                bottom: 0;
                left: 50%;
                transform: translateX(-50%);
                width: 100px;
                height: 3px;
                background-color: #3fbbc0;
            }
        .hero__title {
            margin-bottom: 74px;
            padding-bottom: 20px;
            text-align: center;
            font-weight: 500;
            position: relative;
        }
        .hero__title::after{
             content: "";
             position: absolute;
             bottom: 0;
             left: 50%;
             transform: translateX(-50%);
             width: 100px;
             height: 3px;
             background-color: #00979d;
        }
        .wrapper-gird {
            display: flex;
            flex-wrap: wrap;
        }

        .menu_gird_item {
            margin-top: 40px;
            padding: 0px 50px;
        }

        .menu_gird_item-title {
            font-size: 20px;
            margin-bottom: 12px;
            line-height: 1.6;
            text-align: center;
        }

        .menu_gird_item-text {
            color: #333;
            line-height: 1.47;
            font-size: 15px;
        }

        .section-question {
            margin: 0 0 50px;
        }

            .section-question .container {
                max-width: 924px;
            }

        .question-list-item {
            transition: .3s;
            margin-bottom: 15px;
            border: 2px solid #3fbbc0;
            border-radius: 3px;
            background: #fff;
        }

        .question-list-item_btn {
            position: relative;
            display: flex;
            border: none;
            width: 100%;
            padding: 12px 40px 15px 15px;
            background: 0 0;
            text-align: left;
        }

        .question-list-content {
            border-top: 2px solid #f1f1f1;
            padding: 11px 14px 26px;
            display: none;
        }

            .question-list-content p {
                font-size: 15px;
                color: #000;
            }

            .question-list-content ul li {
                margin-bottom: 8px;
                padding-left: 24px;
                line-height: 1.47;
                font-size: 15px;
                color: #000;
            }
    </style>

</head>
<body id="top">
    <main>
        @RenderBody()
        <div class="loading" style="display:none">Loading&#8230;</div>
    </main>
    @Html.Partial("_PartialFooter")

    <script src="~/Theme/js/jquery.sticky.js"></script>

    <script src="~/Theme/js/custom.js"></script>
    <script src="~/Theme/js/main.js"></script>
    <script src="~/Theme/js/login-social.js" defer type="module"></script>
    <script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
    <!--Reference the autogenerated SignalR hub script. -->
    <script src="~/signalr/hubs"></script>
    <!-- JAVASCRIPT FILES -->
    @RenderSection("scripts", required: false)
    <script>
        var hub = $.connection.requestJoinHub;
        hub.client.updateOnlineCount = function (count) {
            console.log(count)
        };
        $.connection.hub.start().done(function () {
            console.log("Connected to SignalR Hub");
        });
    </script>
</body>
</html>
